  "segments": [
    {
      "id": "PSA.1.1.L1",
      "verse": "1",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.1.H001",
        "PSA.1.1.H002",
        "PSA.1.1.H003",
        "PSA.1.1.H004",
        "PSA.1.1.H005",
        "PSA.1.1.H006",
        "PSA.1.1.H007"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.1.T001",
          "PSA.1.1.T002",
          "PSA.1.1.T003",
          "PSA.1.1.T004",
          "PSA.1.1.T005"
        ],
        "text": "பாக்கியமான மனிதன், துன்மார்க்கர்களுடைய ஆலோசனையின்படி நடக்காமலும்,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "Blessed is the man who walks not in the counsel of the wicked,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.1.L2",
      "verse": "1",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.1.H008",
        "PSA.1.1.H009",
        "PSA.1.1.H010",
        "PSA.1.1.H011"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.1.T006",
          "PSA.1.1.T007",
          "PSA.1.1.T008"
        ],
        "text": "பாவிகளுடைய வழியில் நிற்காமலும்,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "nor stands in the way of sinners,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.1.L3",
      "verse": "1",
      "lineIndex": 3,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.1.H012",
        "PSA.1.1.H013",
        "PSA.1.1.H014",
        "PSA.1.1.H015"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.1.T009",
          "PSA.1.1.T010",
          "PSA.1.1.T011",
          "PSA.1.1.T012"
        ],
        "text": "பரியாசக்காரர்கள் உட்காரும் இடத்தில் உட்காராமலும்,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "nor sits in the seat of scoffers;",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.2.L1",
      "verse": "2",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.2.H003",
        "PSA.1.2.H004",
        "PSA.1.2.H005"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.2.T001",
          "PSA.1.2.T002",
          "PSA.1.2.T003",
          "PSA.1.2.T004"
        ],
        "text": "யெகோவாவின் வேதத்தில் பிரியமாக இருந்து,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "but his delight is in the law of the Lord,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.2.L2",
      "verse": "2",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.2.H006",
        "PSA.1.2.H007",
        "PSA.1.2.H008",
        "PSA.1.2.H009"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.2.T005",
          "PSA.1.2.T006",
          "PSA.1.2.T007",
          "PSA.1.2.T008",
          "PSA.1.2.T009",
          "PSA.1.2.T010"
        ],
        "text": "இரவும் பகலும் அவருடைய வேதத்தில் தியானமாய் இருப்பான்.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "and on his law he meditates day and night.",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.3.L1",
      "verse": "3",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.3.H001",
        "PSA.1.3.H003",
        "PSA.1.3.H004",
        "PSA.1.3.H005",
        "PSA.1.3.H006"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.3.T001",
          "PSA.1.3.T002",
          "PSA.1.3.T003",
          "PSA.1.3.T004"
        ],
        "text": "அவன் நீரோடை ஓரமாக நடப்பட்டு,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "He is like a tree planted by streams of water",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.3.L2",
      "verse": "3",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.3.H008",
        "PSA.1.3.H009",
        "PSA.1.3.H010"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.3.T005",
          "PSA.1.3.T006",
          "PSA.1.3.T007",
          "PSA.1.3.T008",
          "PSA.1.3.T009"
        ],
        "text": "தன்னுடைய காலத்தில் தன்னுடைய கனியைத் தந்து,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "that yields its fruit in its season,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.3.L3",
      "verse": "3",
      "lineIndex": 3,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.3.H001",
        "PSA.1.3.H002",
        "PSA.1.3.H011",
        "PSA.1.3.H012",
        "PSA.1.3.H013"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.3.T010",
          "PSA.1.3.T011",
          "PSA.1.3.T012",
          "PSA.1.3.T013",
          "PSA.1.3.T014"
        ],
        "text": "இலை உதிராமல் இருக்கிற மரத்தைப்போல இருப்பான்.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "and its leaf does not wither.",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.3.L4",
      "verse": "3",
      "lineIndex": 4,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.3.H014",
        "PSA.1.3.H015",
        "PSA.1.3.H016",
        "PSA.1.3.H017"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.3.T015",
          "PSA.1.3.T016",
          "PSA.1.3.T017"
        ],
        "text": "அவன் செய்வதெல்லாம் வாய்க்கும்.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "In all that he does, he prospers.",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.4.L1",
      "verse": "4",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.4.H001",
        "PSA.1.4.H002",
        "PSA.1.4.H003"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.4.T001",
          "PSA.1.4.T002"
        ],
        "text": "துன்மார்க்கர்களோ அப்படியில்லாமல்,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "The wicked are not so,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.4.L2",
      "verse": "4",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.4.H006",
        "PSA.1.4.H007",
        "PSA.1.4.H008",
        "PSA.1.4.H009"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.4.T003",
          "PSA.1.4.T004",
          "PSA.1.4.T005",
          "PSA.1.4.T006",
          "PSA.1.4.T007"
        ],
        "text": "காற்றுப் பறக்கடிக்கும் பதரைப் போல் இருக்கிறார்கள்.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "but are like chaff that the wind drives away.",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.5.L1",
      "verse": "5",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.5.H001",
        "PSA.1.5.H002",
        "PSA.1.5.H005",
        "PSA.1.5.H006"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.5.T001",
          "PSA.1.5.T002",
          "PSA.1.5.T003"
        ],
        "text": "ஆகையால் துன்மார்க்கர்கள் நியாயத்தீர்ப்பிலும்,",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "Therefore the wicked will not stand in the judgment,",
        "method": "source-line"
      },
      "status": "UNREVIEWED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "not-started"
    },
    {
      "id": "PSA.1.5.L2",
      "verse": "5",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.5.H003",
        "PSA.1.5.H004",
        "PSA.1.5.H007",
        "PSA.1.5.H008",
        "PSA.1.5.H009"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.5.T004",
          "PSA.1.5.T005",
          "PSA.1.5.T006",
          "PSA.1.5.T007"
        ],
        "text": "பாவிகள் நீதிமான்களின் சபையிலும் நிலைநிற்பதில்லை.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "nor sinners in the congregation of the righteous;",
        "method": "source-line"
      },
      "status": "UNREVIEWED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "not-started"
    },
    {
      "id": "PSA.1.6.L1",
      "verse": "6",
      "lineIndex": 1,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.6.H002",
        "PSA.1.6.H004"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.6.T001",
          "PSA.1.6.T002",
          "PSA.1.6.T003",
          "PSA.1.6.T004"
        ],
        "text": "யெகோவா நீதிமான்களின் வழியை அறிந்திருக்கிறார்;",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "for the Lord knows the way of the righteous,",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    },
    {
      "id": "PSA.1.6.L2",
      "verse": "6",
      "lineIndex": 2,
      "unitType": "colon",
      "hebrewTokenIds": [
        "PSA.1.6.H006",
        "PSA.1.6.H007",
        "PSA.1.6.H008"
      ],
      "tamil": {
        "tokenIds": [
          "PSA.1.6.T005",
          "PSA.1.6.T006",
          "PSA.1.6.T007"
        ],
        "text": "துன்மார்க்கர்களின் வழியோ அழியும்.",
        "method": "alignment-projection",
        "status": "UNREVIEWED",
        "coverage": 1
      },
      "english": {
        "text": "but the way of the wicked will perish.",
        "method": "source-line"
      },
      "status": "HUMAN_APPROVED",
      "provenance": {
        "origin": "machine",
        "method": "psalms-editor-v0.3"
      },
      "revision": 1,
      "revisions": [],
      "createdAt": "2026-09-18T08:53:19.151Z",
      "updatedAt": "2026-09-18T08:53:19.151Z",
      "legacyStatus": "approved"
    }
