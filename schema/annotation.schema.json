{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgeconn.com/selah/annotation.v0.4.schema.json",
  "title": "Selah / Psalms Editor annotation file — v0.4 (whole Psalter)",
  "description": "One file per psalm for Psalms 1–150. Hebrew-first analytical records are anchored on Hebrew token IDs; Tamil and English are projections. Supersedes v0.3.",
  "type": "object",
  "required": ["schemaVersion", "book", "psalm", "revision", "psalmStatus", "segments", "parallelGroups", "components", "structures", "notes", "validation"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.4.0" },
    "book": { "const": "PSA" },
    "psalm": { "type": "integer", "minimum": 1, "maximum": 150 },
    "revision": { "type": "object", "required": ["hebrew", "tamil", "english", "analysisRunId"], "properties": {
      "hebrew": { "type": "object", "required": ["version"], "properties": { "version": { "type": "string" }, "archiveSha256": { "type": "string" } } },
      "tamil": { "type": "object", "required": ["sha256"], "properties": { "label": { "type": "string" }, "sha256": { "type": "string" } } },
      "english": { "type": "object", "required": ["sha256"], "properties": { "label": { "type": "string" }, "sha256": { "type": "string" } } },
      "analysisRunId": { "type": "string" }
    } },
    "psalmStatus": { "enum": ["not-started", "in-progress", "disputed", "approved"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "completion": { "type": "string" },
    "analysisMode": { "type": "string" },
    "rolloutMethod": { "type": "string" },
    "sourceEdition": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sha256": { "type": "string" },
        "retrieved": { "type": "string" },
        "source": { "type": "string" },
        "policy": { "type": "string" }
      }
    },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "parallelGroups": { "type": "array", "items": { "$ref": "#/$defs/parallelGroup" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "structures": { "type": "array", "items": { "$ref": "#/$defs/structure" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "verseAnalyses": { "type": "array", "items": { "$ref": "#/$defs/verseAnalysis" } },
    "validation": { "$ref": "#/$defs/validation" },
    "migration": { "type": ["object", "null"], "properties": {
      "fromVersion": { "type": "string" }, "importedAt": { "type": "string" }, "sourceSha256": { "type": "string" },
      "report": { "type": "array", "items": { "type": "object", "required": ["kind", "text"], "properties": { "kind": { "enum": ["ok", "warn", "repair", "flag"] }, "text": { "type": "string" }, "count": { "type": "integer" }, "ids": { "type": "array", "items": { "type": "string" } } } } }
    } },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "hebrewTokenId": { "type": "string", "pattern": "^PSA\\.[0-9]{1,3}\\.(front|[0-9]{1,3})\\.H[0-9]{3}$" },
    "tamilTokenId": { "type": "string", "pattern": "^PSA\\.[0-9]{1,3}\\.(d[0-9]*|[0-9]{1,3})\\.T[0-9]{3}$" },
    "segmentId": { "type": "string", "pattern": "^PSA\\.[0-9]{1,3}\\.(front|[0-9]{1,3})\\.L[0-9]{1,2}$" },
    "groupId": { "type": "string", "pattern": "^P[0-9]{3}$" },
    "componentId": { "type": "string", "pattern": "^C[0-9]{3}$" },
    "structureId": { "type": "string", "pattern": "^(S|CH|AC|RF|IN)[0-9]{3}$" },
    "noteId": { "type": "string", "pattern": "^N[0-9]{3}$" },
    "reviewStatus": { "enum": ["UNREVIEWED", "AI_PROPOSED", "HUMAN_APPROVED", "HUMAN_REJECTED", "HUMAN_MODIFIED", "NEEDS_DISCUSSION"] },
    "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
    "parallelismType": { "enum": ["SYNONYMOUS", "ANTITHETIC", "SYNTHETIC", "CLIMACTIC", "STAIRCASE", "EMBLEMATIC", "CHIASTIC", "JANUS", "CONSEQUENTIAL", "REPETITION", "OTHER", "UNCERTAIN"] },
    "transformationType": { "enum": ["restatement", "expansion", "specification", "contrast", "reversal", "completion", "intensification", "consequence", "other"] },
    "parallelismAspect": { "enum": ["grammatical", "lexical", "semantic", "phonological"] },
    "structureType": { "enum": ["SECTION", "SUBSECTION", "STROPHE", "STANZA", "REFRAIN", "INCLUSIO", "CHIASM", "ACROSTIC", "CONTRAST", "COMPARISON", "REPETITION", "SPEAKER_CHANGE", "ADDRESSEE_CHANGE", "PROGRESSION", "OTHER"] },
    "unitType": { "enum": ["colon", "line", "superscription", "heading"] },
    "provenance": { "type": "object", "required": ["origin"], "properties": {
      "origin": { "enum": ["human", "machine", "migration", "documented-alternative", "ai-literature-synthesis", "ai-original-analysis"] },
      "method": { "type": "string" },
      "sources": { "type": "array", "items": { "type": "string" } },
      "evidence": { "type": "array", "items": { "type": "object", "required": ["kind", "text"], "properties": { "kind": { "type": "string" }, "text": { "type": "string" }, "tokenIds": { "type": "array", "items": { "type": "string" } }, "source": { "type": "string" } } } },
      "sourceReference": { "type": "string" }
    } },
    "revisionEntry": { "type": "object", "required": ["revision", "at", "change"], "properties": {
      "revision": { "type": "integer" }, "at": { "type": "string" }, "change": { "type": "string" }, "by": { "type": "string" }, "status": { "$ref": "#/$defs/reviewStatus" }, "snapshot": { "type": "object" }
    } },
    "recordBase": { "type": "object", "required": ["status", "provenance", "revision", "revisions", "createdAt", "updatedAt"], "properties": {
      "status": { "$ref": "#/$defs/reviewStatus" }, "legacyStatus": { "type": "string" }, "provenance": { "$ref": "#/$defs/provenance" }, "confidence": { "$ref": "#/$defs/confidence" }, "note": { "type": "string" },
      "revision": { "type": "integer", "minimum": 1 }, "revisions": { "type": "array", "items": { "$ref": "#/$defs/revisionEntry" } }, "createdAt": { "type": "string" }, "updatedAt": { "type": "string" }
    } },
    "projection": { "type": "object", "required": ["tokenIds", "method", "status"], "properties": {
      "tokenIds": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string" }, "method": { "enum": ["human", "alignment-projection", "migration"] }, "status": { "$ref": "#/$defs/reviewStatus" }, "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
    } },
    "segment": { "allOf": [{ "$ref": "#/$defs/recordBase" }, { "type": "object", "required": ["id", "verse", "lineIndex", "unitType", "hebrewTokenIds"], "properties": {
      "id": { "$ref": "#/$defs/segmentId" }, "verse": { "type": "string" }, "lineIndex": { "type": "integer", "minimum": 1 }, "unitType": { "$ref": "#/$defs/unitType" },
      "hebrewTokenIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hebrewTokenId" } }, "tamil": { "$ref": "#/$defs/projection" }, "english": { "type": "object", "properties": { "text": { "type": "string" }, "method": { "type": "string" } } }, "alternativeOf": { "$ref": "#/$defs/segmentId" }
    } }] },
    "parallelGroup": { "allOf": [{ "$ref": "#/$defs/recordBase" }, { "type": "object", "required": ["id", "lineIds", "type"], "properties": {
      "id": { "$ref": "#/$defs/groupId" }, "lineIds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/segmentId" } }, "type": { "$ref": "#/$defs/parallelismType" }, "suggestedType": { "$ref": "#/$defs/parallelismType" },
      "transformation": { "type": "array", "items": { "$ref": "#/$defs/transformationType" } }, "aspects": { "type": "array", "items": { "$ref": "#/$defs/parallelismAspect" } }, "poeticEffect": { "type": "array", "items": { "type": "string" } }, "explanation": { "type": "string" }
    } }] },
    "component": { "allOf": [{ "$ref": "#/$defs/recordBase" }, { "type": "object", "required": ["id", "label", "parallelGroupId", "hebrewTokenIds"], "properties": {
      "id": { "$ref": "#/$defs/componentId" }, "label": { "enum": ["a", "b", "c", "d", "e", "f", "g", "h", "i"] }, "parallelGroupId": { "oneOf": [{ "$ref": "#/$defs/groupId" }, { "type": "null" }] },
      "hebrewTokenIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hebrewTokenId" } }, "tamil": { "$ref": "#/$defs/projection" }, "semanticFunction": { "type": "string" }
    } }] },
    "structure": { "allOf": [{ "$ref": "#/$defs/recordBase" }, { "type": "object", "required": ["id", "type", "startLineId", "endLineId", "parentId"], "properties": {
      "id": { "$ref": "#/$defs/structureId" }, "type": { "$ref": "#/$defs/structureType" }, "label": { "type": ["string", "null"] }, "title": { "type": "string" }, "startLineId": { "$ref": "#/$defs/segmentId" }, "endLineId": { "$ref": "#/$defs/segmentId" },
      "parentId": { "oneOf": [{ "$ref": "#/$defs/structureId" }, { "type": "null" }] }, "correspondences": { "type": "array", "items": { "type": "object", "required": ["with", "relation"], "properties": { "with": { "$ref": "#/$defs/structureId" }, "relation": { "enum": ["mirror", "repeat", "contrast", "frame"] } } } }, "role": { "enum": ["primary", "secondary", "alternative"] }, "legacyId": { "type": "string" }
    } }] },
    "note": { "allOf": [{ "$ref": "#/$defs/recordBase" }, { "type": "object", "required": ["id", "kind", "targetIds", "text"], "properties": {
      "id": { "$ref": "#/$defs/noteId" }, "kind": { "enum": ["scholarly", "structure", "translation-significance", "tamil-observation", "reviewer", "source-reference", "migration"] }, "targetIds": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string" }
    } }] },
    "verseAnalysis": {
      "type": "object",
      "required": ["verse", "decision", "explanation", "segmentIds", "status"],
      "properties": {
        "verse": { "type": "integer", "minimum": 1 },
        "decision": { "type": "string" },
        "explanation": { "type": "string" },
        "segmentIds": { "type": "array", "items": { "$ref": "#/$defs/segmentId" } },
        "status": { "$ref": "#/$defs/reviewStatus" }
      }
    },
    "validation": { "type": "object", "required": ["runAt", "issues"], "properties": {
      "runAt": { "type": "string" }, "issues": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "entityType", "entityId", "message"], "properties": {
        "code": { "enum": ["SEGMENT_TOKEN_UNCOVERED", "SEGMENT_TOKEN_DUPLICATE", "SEGMENT_INVALID_TOKEN", "SEGMENT_ACCENT_MISMATCH", "GROUP_LINE_IN_MULTIPLE_GROUPS", "GROUP_SPANS_VERSES", "GROUP_INCOMPLETE", "COMPONENT_UNATTACHED", "COMPONENT_DUPLICATE", "COMPONENT_CONFLICT", "COMPONENT_INVALID_TOKEN", "COMPONENT_OUTSIDE_GROUP_LINES", "STRUCTURE_INVALID_RANGE", "STRUCTURE_ORPHAN_CHILD", "STRUCTURE_CHIASM_WITHOUT_PARENT", "STRUCTURE_CORRESPONDENCE_ASYMMETRIC", "STATUS_STALE_APPROVAL", "ID_DUPLICATE", "SOURCE_MISMATCH"] },
        "severity": { "enum": ["error", "warning", "info"] }, "entityType": { "enum": ["segment", "parallelGroup", "component", "structure", "note", "file"] }, "entityId": { "type": "string" }, "message": { "type": "string" }, "scholarly": { "type": "boolean" }
      } } }
    } }
  }
}
